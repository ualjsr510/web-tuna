ize: 15px">Ficha del certamen seleccionado</h2><label style="display: flex; flex-direction: column; gap: 6px; "><span style="font-size: 12px; font-weight: 600">Nombre</span><input type="text" placeholder="Certamen Nacional de Tunas" style="height: 38px; border: 1px solid var(--line); padding: 0 10px; font-size: 13px; font-family: inherit; box-sizing: border-box; width: 100%; background: var(--card); color: var(--ink)"></label><label style="display: flex; flex-direction: column; gap: 6px; "><span style="font-size: 12px; font-weight: 600">Fecha</span><input type="date" placeholder="" style="height: 38px; border: 1px solid var(--line); padding: 0 10px; font-size: 13px; font-family: inherit; box-sizing: border-box; width: 100%; background: var(--card); color: var(--ink)"></label><label style="display: flex; flex-direction: column; gap: 6px; "><span style="font-size: 12px; font-weight: 600">Lugar</span><input type="text" placeholder="Murcia" style="height: 38px; border: 1px solid var(--line); padding: 0 10px; font-size: 13px; font-family: inherit; box-sizing: border-box; width: 100%; background: var(--card); color: var(--ink)"></label><label style="display: flex; flex-direction: column; gap: 6px; "><span style="font-size: 12px; font-weight: 600">Premios</span><textarea rows="3" placeholder="Premios obtenidos" style="height: 38px; border: 1px solid var(--line); padding: 0 10px; font-size: 13px; font-family: inherit; box-sizing: border-box; width: 100%; background: var(--card); color: var(--ink); height: 80px; padding: 8px 10px; resize: none"></textarea></label><div style="display: flex; gap: 10px; align-items: center; "><button type="button" style="font-size: 14px; font-family: inherit; background: var(--accent); color: var(--on-accent); border: 1px solid var(--accent); padding: 12px 20px; ">Guardar cambios</button><a href="#" data-noop="1" style="text-decoration: none; font-size: 14px; display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; color: var(--ink); padding: 11px 20px; border: 1px solid var(--accent); ">Eliminar</a></div><section style="border: 1px solid var(--line); background: var(--card); padding: 16px; display: flex; flex-direction: column; gap: 12px; box-sizing: border-box; gap: 8px; padding: 12px; border: 1px dashed var(--muted); background: var(--soft-2)"><p style="margin: 0; font-size: 12px; color: var(--ink); line-height: 1.5; ">¿Eliminar este certamen? Esta acción no se puede deshacer.</p><div style="display: flex; gap: 8px; align-items: center; "><a href="#" data-noop="1" style="text-decoration: none; font-size: 14px; display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; color: var(--ink); padding: 11px 20px; border: 1px solid var(--line); padding: 8px 14px; font-size: 12px">Cancelar</a><a href="#" data-noop="1" style="text-decoration: none; font-size: 14px; display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; background: var(--accent); color: var(--on-accent); padding: 12px 20px; border: 1px solid var(--accent); padding: 8px 14px; font-size: 12px">Sí, eliminar</a></div></section><a href="#" data-noop="1" style="text-decoration: none; font-size: 14px; display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; color: var(--ink); padding: 11px 20px; border: 1px solid var(--line); ">Volver al listado</a></section></div></div></main>
    </div>

</div></section>
<section class="screen" data-route="admin/CertamenNuevo.html"><div class="wireframe">

    <header style="height: 72px; flex: none; border-bottom: 1px solid var(--line); display: flex; align-items: center; gap: 20px; padding: 0 32px; box-sizing: border-box">
      <a href="#/admin/index.html" style="width: 92px; height: 38px; border: 1px solid var(--accent); display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-decoration: none">TUNA</a>
      <span style="font-size: 13px; color: var(--muted)">Panel de administración</span>
      <div style="margin-left: auto; display: flex; align-items: center; gap: 14px">
        <span style="font-size: 13px; color: var(--muted)">Administrador</span>
        <a href="#/visitante/index.html" style="font-size: 13px; text-decoration: none; border: 1px solid var(--accent); padding: 9px 14px">Cerrar sesión</a>
      </div>
    </header>
    <div style="flex: 1; min-height: 0; display: flex">
      <aside style="width: 232px; flex: none; border-right: 1px solid var(--line); padding: 20px 16px; box-sizing: border-box; display: flex; flex-direction: column; gap: 4px"><a href="#/admin/index.html" style="text-decoration: none; font-size: 13px; padding: 11px 14px; border: 1px solid transparent">Panel de estadísticas</a><a href="#/admin/Contratos.html" style="text-decoration: none; font-size: 13px; padding: 11px 14px; border: 1px solid transparent">1 Contratos</a><a href="#/admin/Clientes.html" style="text-decoration: none; font-size: 13px; padding: 11px 14px; border: 1px solid transparent">2 Cartera de clientes</a><a href="#/admin/Pedidos.html" style="text-decoration: none; font-size: 13px; padding: 11px 14px; border: 1px solid transparent">3 Pedidos de la tienda</a><a href="#/admin/Productos.html" style="text-decoration: none; font-size: 13px; padding: 11px 14px; border: 1px solid transparent">4 Productos de la tienda</a><a href="#/admin/Miembros.html" style="text-decoration: none; font-size: 13px; padding: 11px 14px; border: 1px solid transparent">5 Lista de miembros</a><a href="#/admin/Cuenta.html" style="text-decoration: none; font-size: 13px; padding: 11px 14px; border: 1px solid transparent">6 Cuenta</a><a href="#/admin/Certamenes.html" style="text-decoration: none; font-size: 13px; padding: 11px 14px; background: var(--accent); color: var(--on-accent)">7 Certámenes</a></aside>
      <main style="flex: 1; min-width: 0; min-height: 0; padding: 24px 32px; box-sizing: border-box; display: flex; flex-direction: column; gap: 20px"><nav style="font-size: 12px; color: var(--muted); flex: none"><a href="#/admin/index.html" style="text-decoration: none; color: var(--muted)">Panel</a> › <a href="#/admin/Certamenes.html" style="text-decoration: none; color: var(--muted)">Gestionar certámenes</a> › <span style="color: var(--ink)">Crear nuevo certamen</span></nav><div style="flex: none"><h1 style="margin: 0; font-size: 26px">Crear nuevo certamen</h1><p style="margin: 6px 0 0; font-size: 13px; color: var(--muted)">Datos del nuevo certamen</p></div><section style="border: 1px solid var(--line); background: var(--card); padding: 16px; display: flex; flex-direction: column; gap: 12px; box-sizing: border-box; max-width: 820px"><section style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; "><label style="display: flex; flex-direction: column; gap: 6px; "><span style="font-size: 12px; font-weight: 600">Nombre</span><input type="text" placeholder="Certamen Nacional de Tunas" style="height: 38px; border: 1px solid var(--line); padding: 0 10px; font-size: 13px; font-family: inherit; box-sizing: border-box; width: 100%; background: var(--card); color: var(--ink)"></label><label style="display: flex; flex-direction: column; gap: 6px; "><span style="font-size: 12px; font-weight: 600">Fecha</span><input type="date" placeholder="" style="height: 38px; border: 1px solid var(--line); padding: 0 10px; font-size: 13px; font-family: inherit; box-sizing: border-box; width: 100%; background: var(--card); color: var(--ink)"></label><label style="display: flex; flex-direction: column; gap: 6px; "><span style="font-size: 12px; font-weight: 600">Lugar</span><input type="text" placeholder="Almería" style="height: 38px; border: 1px solid var(--line); padding: 0 10px; font-size: 13px; font-family: inherit; box-sizing: border-box; width: 100%; background: var(--card); color: var(--ink)"></label><label style="display: flex; flex-direction: column; gap: 6px; "><span style="font-size: 12px; font-weight: 600">Cartel</span><input type="file" placeholder="" style="height: 38px; border: 1px solid var(--line); padding: 0 10px; font-size: 13px; font-family: inherit; box-sizing: border-box; width: 100%; background: var(--card); color: var(--ink)"></label><label style="display: flex; flex-direction: column; gap: 6px; grid-column: span 2"><span style="font-size: 12px; font-weight: 600">Premios</span><textarea rows="3" placeholder="Premios obtenidos" style="height: 38px; border: 1px solid var(--line); padding: 0 10px; font-size: 13px; font-family: inherit; box-sizing: border-box; width: 100%; background: var(--card); color: var(--ink); height: 80px; padding: 8px 10px; resize: none"></textarea></label></section><div style="display: flex; gap: 12px; align-items: center; "><button type="button" style="font-size: 14px; font-family: inherit; background: var(--accent); color: var(--on-accent); border: 1px solid var(--accent); padding: 12px 20px; ">Guardar</button><a href="#/admin/Certamenes.html" style="text-decoration: none; font-size: 14px; display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; color: var(--ink); padding: 11px 20px; border: 1px solid var(--line); ">Cancelar</a></div></section></main>
    </div>

</div></section>
</div></div>
<div id="toast" role="status"></div>
<script>
const ROUTES={"visitante/index.html": ["0", "Inicio visitante"], "visitante/Conoce.html": ["1", "Conoce la tuna"], "visitante/Historia.html": ["1.1", "Historia"], "visitante/Miembros.html": ["1.2", "Miembros"], "visitante/Contratacion.html": ["2", "Contratación de nuestros servicios"], "visitante/AccesoContratacion.html": ["2.1", "Inicio de sesión para contratación"], "visitante/FormularioContratacion.html": ["2.1.1", "Rellenar formulario de contratación"], "visitante/Multimedia.html": ["3", "Contenido multimedia"], "visitante/MejoresMomentos.html": ["3.1", "Nuestros mejores momentos"], "visitante/Videos.html": ["3.1.1", "Vídeos"], "visitante/Fotos.html": ["3.1.2", "Fotos"], "visitante/Certamenes.html": ["3.2", "Certámenes"], "visitante/Tienda.html": ["4", "Tienda"], "visitante/Catalogo.html": ["4.1", "Catálogo"], "visitante/Cesta.html": ["4.2", "Cesta"], "visitante/AccesoPedido.html": ["4.2.1", "Iniciar sesión o registrarse para realizar pedido"], "visitante/DireccionEnvio.html": ["4.2.1.1", "Dirección de envío"], "visitante/Cancionero.html": ["5", "Cancionero"], "visitante/Repertorio.html": ["5.1", "Nuestro repertorio de canciones"], "visitante/Spotify.html": ["5.2", "Escúchanos en Spotify"], "visitante/Unete.html": ["6", "Únete a nosotros"], "visitante/Formulario.html": ["6.1", "Formulario para unirse"], "visitante/LocalEnsayo.html": ["6.2", "Local de ensayo"], "visitante/Acceso.html": ["7", "Inicio de sesión"], "visitante/RecuperarContrasena.html": ["7.1", "Recuperar contraseña"], "visitante/Registro.html": ["7.2", "Registrarse"], "cliente/index.html": ["0", "Inicio de cliente"], "cliente/Contratos.html": ["1", "Ver historial de contratos"], "cliente/ContratoDetalle.html": ["1.1", "Ver contrato en detalle"], "cliente/Pedidos.html": ["2", "Ver historial de pedidos"], "cliente/PedidoDetalle.html": ["2.1", "Ver pedido en detalle"], "cliente/PedidoEditar.html": ["2.1.1", "Editar datos del pedido"], "cliente/PedidoDevolucion.html": ["2.1.2", "Tramitar devolución"], "cliente/Cuenta.html": ["3", "Gestionar cuenta"], "cliente/CuentaDatos.html": ["3.1", "Modificar información personal"], "cliente/CuentaPassword.html": ["3.2", "Cambiar contraseña"], "admin/index.html": ["0", "Panel de administración con estadísticas"], "admin/Contratos.html": ["1", "Gestionar contratos"], "admin/ContratoDetalle.html": ["1.1", "Ver contrato en detalle"], "admin/Clientes.html": ["2", "Gestionar cartera de clientes"], "admin/FichaCliente.html": ["2.1", "Ver ficha de cliente"], "admin/ContratosCliente.html": ["2.1.1", "Ver contratos del cliente"], "admin/PedidosCliente.html": ["2.1.2", "Ver pedidos del cliente"], "admin/Pedidos.html": ["3", "Gestionar pedidos de la tienda"], "admin/PedidoDetalle.html": ["3.1", "Ver pedido en detalle"], "admin/Productos.html": ["4", "Gestionar productos de la tienda"], "admin/ProductoNuevo.html": ["4.1", "Añadir producto"], "admin/ProductosGestion.html": ["4.2", "Modificar o eliminar producto"], "admin/Miembros.html": ["5", "Gestionar lista de miembros"], "admin/MiembrosGestion.html": ["5.1", "Modificar o eliminar miembro existente"], "admin/MiembroNuevo.html": ["5.2", "Añadir nuevos miembros"], "admin/Cuenta.html": ["6", "Gestionar cuenta"], "admin/CuentaDatos.html": ["6.1", "Modificar información personal"], "admin/CuentaPassword.html": ["6.2", "Cambiar contraseña"], "admin/Certamenes.html": ["7", "Gestionar certámenes"], "admin/CertamenesGestion.html": ["7.1", "Modificar o eliminar certamen existente"], "admin/CertamenNuevo.html": ["7.2", "Crear nuevo certamen"]};
const PROFS={visitante:'Visitante',cliente:'Cliente',admin:'Administrador'};
const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
const sel=$('#sel'), holder=$('#holder'), stage=$('#stage');
function current(){let r=decodeURIComponent(location.hash.replace(/^#\//,''));return ROUTES[r]?r:'visitante/index.html'}
function fit(){const s=Math.min(1,(innerWidth-24)/1280);stage.style.transform='scale('+s+')';holder.style.width=1280*s+'px';holder.style.height=1024*s+'px'}
function render(){
  const r=current(), prof=r.split('/')[0];
  $$('.screen').forEach(e=>e.classList.toggle('on',e.dataset.route===r));
  $$('.tab').forEach(b=>b.classList.toggle('on',b.dataset.p===prof));
  sel.innerHTML=Object.entries(ROUTES).filter(([k,v])=>k.startsWith(prof+'/')).map(([k,v])=>`<option value="${k}"${k===r?' selected':''}>${v[0]} · ${v[1]}</option>`).join('');
  document.title='Mockup · '+ROUTES[r][1]+' ('+PROFS[prof]+')';
  scrollTo(0,0);
}
let tt;function toast(t){const e=$('#toast');e.textContent=t;e.classList.add('on');clearTimeout(tt);tt=setTimeout(()=>e.classList.remove('on'),2200)}
addEventListener('hashchange',render);addEventListener('resize',fit);
$$('.tab').forEach(b=>b.onclick=()=>{location.hash='#/'+b.dataset.p+'/index.html'});
sel.onchange=()=>{location.hash='#/'+sel.value};
document.addEventListener('click',e=>{
  const a=e.target.closest('a[data-noop]');if(a){e.preventDefault();return}
  const b=e.target.closest('.wireframe button');if(!b)return;
  if(b.dataset.go){location.hash='#/'+b.dataset.go;return}
  const bar=b.closest('.wireframe > div');
  if(bar&&/cookies/i.test(bar.textContent)){bar.style.display='none';return}
  toast('«'+b.textContent.trim()+'» — acción simulada en el mockup');
});
fit();render();
</script>
</body>
</html>
