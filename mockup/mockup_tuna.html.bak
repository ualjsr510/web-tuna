<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Mockup · Web de la tuna</title>
<style>
:root{--ink:#1c1417;--ink-2:#3a2d30;--muted:#7a6a62;--muted-2:#5d4f48;--paper:#f8f4ec;--card:#ffffff;--line:#ddd3c2;--line-soft:#ece4d5;
--soft:#efe7d6;--soft-2:#faf6ee;--accent:#7a1f2b;--accent-2:#5e1520;--gold:#b8923a;--on-accent:#fbf3df;
--img:repeating-linear-gradient(135deg,#e6d9c0 0 12px,#ece1cb 12px 24px);
--hero:linear-gradient(135deg,#4d1019 0%,#7a1f2b 55%,#5e1520 100%);
--serif:"Iowan Old Style","Palatino Linotype",Palatino,"Book Antiqua",Georgia,serif;--sans:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
*{box-sizing:border-box}
html,body{margin:0;padding:0;background:#2a2124}
body{font-family:var(--sans);min-height:100vh}
#bar{position:sticky;top:0;z-index:50;height:52px;background:#161012;color:#f0e6d0;display:flex;align-items:center;gap:14px;padding:0 16px;border-bottom:2px solid var(--gold);font-size:13px}
#bar b{font-family:var(--serif);font-size:15px;letter-spacing:.04em;margin-right:6px;white-space:nowrap}
#bar .tabs{display:flex;gap:4px}
#bar button.tab{background:transparent;color:#f0e6d0;border:1px solid #4a3b3e;padding:7px 12px;font:inherit;cursor:pointer;border-radius:3px}
#bar button.tab.on{background:var(--gold);color:#1c1417;border-color:var(--gold);font-weight:600}
#bar select{background:#241b1e;color:#f0e6d0;border:1px solid #4a3b3e;padding:7px 8px;font:inherit;border-radius:3px;max-width:420px;min-width:0;flex:1}
#bar .hint{margin-left:auto;color:#a99a86;font-size:12px;white-space:nowrap}
#holder{margin:20px auto 40px;position:relative}
#stage{width:1280px;height:1024px;transform-origin:top left}
.screen{display:none}.screen.on{display:block}
.wireframe{width:1280px;height:1024px;background:var(--paper);color:var(--ink);font-family:var(--sans);display:flex;flex-direction:column;box-shadow:0 8px 30px rgba(0,0,0,.45);overflow:hidden}
.wireframe a{color:var(--accent)}
.wireframe a:hover{color:var(--accent-2);opacity:.9}
.wireframe a[style*="text-decoration: none"]{color:var(--ink)}
.wireframe a[style*="text-decoration: none"]:hover{color:var(--accent)}
.wireframe h1,.wireframe h2,.wireframe h3{font-family:var(--serif);font-weight:600;letter-spacing:.005em}
.wireframe main h1::after{content:"";display:block;width:44px;height:3px;background:var(--gold);margin-top:8px}
.wireframe section[style*="height: 200px"] h1{color:#fbf3df;font-size:38px !important}
.wireframe section[style*="height: 200px"] h1::after{margin:10px auto 0}
.wireframe section[style*="height: 200px"] p{color:#e9d8ae !important}
.wireframe > header{background:var(--card);border-bottom:2px solid var(--gold) !important}
.wireframe > header > a:first-child{background:var(--accent);color:var(--on-accent);border-color:var(--accent) !important;font-family:var(--serif);font-size:14px !important}
.wireframe > header > a:first-child:hover{color:var(--on-accent)}
.wireframe > footer{background:var(--ink);color:#b9a995 !important;border-top:3px solid var(--gold) !important}
.wireframe > footer p{color:#b9a995}
.wireframe > footer p[style*="font-weight: 600"]{color:#f0e6d0 !important;font-family:var(--serif);font-size:13px}
.wireframe > footer a{color:#e0c98f !important}
.wireframe aside{background:var(--card)}
.wireframe a[style*="padding: 16px"]:hover{border-color:var(--gold) !important;box-shadow:0 2px 10px rgba(122,31,43,.12)}
.wireframe section[style*="border: 1px solid"],.wireframe a[style*="padding: 16px"]{border-radius:4px;box-shadow:0 1px 2px rgba(60,30,30,.06)}
.wireframe a[style*="inline-flex"],.wireframe button,.wireframe input,.wireframe select,.wireframe textarea{border-radius:3px}
.wireframe a[style*="inline-flex"]:hover{filter:brightness(1.12)}
.wireframe button{cursor:pointer}
.wireframe button[style*="var(--accent)"]:hover{filter:brightness(1.12)}
.wireframe input:focus,.wireframe select:focus,.wireframe textarea:focus{outline:2px solid var(--gold);outline-offset:0}
.wireframe table{background:var(--card)}
.wireframe th{color:var(--ink-2);font-family:var(--sans);text-transform:uppercase;font-size:10.5px !important;letter-spacing:.06em}
.wireframe tbody tr:hover td{background:var(--soft-2)}
.wireframe > div[style*="border-top: 2px solid var(--gold)"]{box-shadow:0 -2px 12px rgba(0,0,0,.06)}
.badge{display:inline-block;padding:2px 9px;border-radius:99px;font-size:11px;font-weight:600;line-height:1.5}
.badge.ok{background:#dcebd9;color:#24592b}.badge.warn{background:#f6e7bd;color:#6b4e00}
.badge.info{background:#e1e6f2;color:#2c3e66}.badge.bad{background:#f3d3d6;color:#7a1f2b}
#toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%) translateY(20px);background:#161012;color:#f6e7c1;border:1px solid var(--gold);padding:12px 18px;border-radius:4px;font-size:13px;opacity:0;pointer-events:none;transition:.25s;z-index:99}
#toast.on{opacity:1;transform:translateX(-50%) translateY(0)}
@media (max-width:760px){#bar .hint{display:none}}
</style>
</head>
<body>
<div id="bar"><b>MOCKUP · TUNA</b><div class="tabs"><button class="tab" data-p="visitante">Visitante</button><button class="tab" data-p="cliente">Cliente</button><button class="tab" data-p="admin">Administrador</button></div><select id="sel" aria-label="Pantalla"></select><span class="hint">57 pantallas · navega con los enlaces</span></div>
<div id="holder"><div id="stage">
<section class="screen" data-route="visitante/index.html"><div class="wireframe">

    <header style="height: 72px; flex: none; border-bottom: 1px solid var(--line); display: flex; align-items: center; gap: 28px; padding: 0 48px; box-sizing: border-box">
      <a href="#/visitante/index.html" style="width: 92px; height: 38px; border: 1px solid var(--accent); display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-decoration: none">TUNA</a>
      <nav style="display: flex; gap: 20px; font-size: 13px">
        <a href="#/visitante/Conoce.html" style="text-decoration: none">Conoce la tuna</a>
        <a href="#/visitante/Contratacion.html" style="text-decoration: none">Contratación</a>
        <a href="#/visitante/Multimedia.html" style="text-decoration: none">Multimedia</a>
        <a href="#/visitante/Tienda.html" style="text-decoration: none">Tienda</a>
        <a href="#/visitante/Cancionero.html" style="text-decoration: none">Cancionero</a>
        <a href="#/visitante/Unete.html" style="text-decoration: none">Únete</a>
      </nav>
      <div style="margin-left: auto; display: flex; align-items: center; gap: 14px">
        <a href="#/visitante/Cesta.html" style="font-size: 13px; text-decoration: none; border: 1px solid var(--line); padding: 9px 12px">Cesta (0)</a>
        <a href="#/visitante/Acceso.html" style="font-size: 13px; text-decoration: none; border: 1px solid var(--accent); padding: 9px 14px">Iniciar sesión</a>
        <a href="#/visitante/Contratacion.html" style="font-size: 13px; text-decoration: none; background: var(--accent); color: var(--on-accent); padding: 10px 15px">Contratar</a>
      </div>
    </header>

    <main style="flex: 1; min-height: 0; padding: 24px 48px; box-sizing: border-box; display: flex; flex-direction: column; gap: 24px">

      <section style="height: 200px; flex: none; border: 1px solid var(--accent); background: var(--hero); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px">
        <p style="margin: 0; font-size: 11px; color: var(--muted-2); letter-spacing: 0.1em; text-transform: uppercase">Imagen de cabecera</p>
        <h1 style="margin: 0; font-size: 34px">Tuna de Derecho de Almería</h1>
        <p style="margin: 0; font-size: 14px; color: var(--muted-2)">Música, tradición y alegría en cada ronda</p>
      </section>

      <section style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px">
        <a href="#/visitante/Conoce.html" style="text-decoration: none; border: 1px solid var(--line); background: var(--card); padding: 16px; display: flex; flex-direction: column; gap: 10px">
          <div style="height: 70px; background: var(--img); border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; font-size: 11px; color: var(--muted-2)">Imagen</div>
          <h3 style="margin: 0; font-size: 15px">1 Conoce la tuna</h3>
          <p style="margin: 0; font-size: 12px; color: var(--muted)">Historia y miembros</p>
        </a>
        <a href="#/visitante/Contratacion.html" style="text-decoration: none; border: 1px solid var(--line); background: var(--card); padding: 16px; display: flex; flex-direction: column; gap: 10px">
          <div style="height: 70px; background: var(--img); border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; font-size: 11px; color: var(--muted-2)">Imagen</div>
          <h3 style="margin: 0; font-size: 15px">2 Contratación</h3>
          <p style="margin: 0; font-size: 12px; color: var(--muted)">Pide cuenta para contratar</p>
        </a>
        <a href="#/visitante/Multimedia.html" style="text-decoration: none; border: 1px solid var(--line); background: var(--card); padding: 16px; display: flex; flex-direction: column; gap: 10px">
          <div style="height: 70px; background: var(--img); border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; font-size: 11px; color: var(--muted-2)">Imagen</div>
          <h3 style="margin: 0; font-size: 15px">3 Contenido multimedia</h3>
          <p style="margin: 0; font-size: 12px; color: var(--muted)">Mejores momentos y certámenes</p>
        </a>
        <a href="#/visitante/Tienda.html" style="text-decoration: none; border: 1px solid var(--line); background: var(--card); padding: 16px; display: flex; flex-direction: column; gap: 10px">
          <div style="height: 70px; background: var(--img); border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; font-size: 11px; color: var(--muted-2)">Imagen</div>
          <h3 style="margin: 0; font-size: 15px">4 Tienda</h3>
          <p style="margin: 0; font-size: 12px; color: var(--muted)">Catálogo y cesta</p>
        </a>
        <a href="#/visitante/Cancionero.html" style="text-decoration: none; border: 1px solid var(--line); background: var(--card); padding: 16px; display: flex; flex-direction: column; gap: 10px">
          <div style="height: 70px; background: var(--img); border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; font-size: 11px; color: var(--muted-2)">Imagen</div>
          <h3 style="margin: 0; font-size: 15px">5 Cancionero</h3>
          <p style="margin: 0; font-size: 12px; color: var(--muted)">Repertorio y Spotify</p>
        </a>
        <a href="#/visitante/Unete.html" style="text-decoration: none; border: 1px solid var(--line); background: var(--card); padding: 16px; display: flex; flex-direction: column; gap: 10px">
          <div style="height: 70px; background: var(--img); border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; font-size: 11px; color: var(--muted-2)">Imagen</div>
          <h3 style="margin: 0; font-size: 15px">6 Únete a nosotros</h3>
          <p style="margin: 0; font-size: 12px; color: var(--muted)">Formulario y local de ensayo</p>
        </a>
      </section>

      <section style="flex: none; border: 1px solid var(--accent); padding: 18px 24px; display: flex; align-items: center; gap: 24px">
        <div>
          <h2 style="margin: 0 0 4px; font-size: 17px">¿Queréis contratarnos?</h2>
          <p style="margin: 0; font-size: 13px; color: var(--muted)">Hace falta iniciar sesión o registrarse para enviar la solicitud.</p>
        </div>
        <a href="#/visitante/Contratacion.html" style="margin-left: auto; background: var(--accent); color: var(--on-accent); text-decoration: none; font-size: 14px; padding: 12px 20px">Contratar</a>
      </section>

    </main>

    <div style="flex: none; border-top: 2px solid var(--gold); background: var(--soft); padding: 12px 48px; display: flex; align-items: center; gap: 16px; box-sizing: border-box">
      <p style="margin: 0; font-size: 12px; color: var(--ink-2)">Aviso de cookies: usamos cookies propias y de terceros. <a href="#" data-noop="1">Más información</a>.</p>
      <div style="margin-left: auto; display: flex; gap: 10px">
        <button type="button" style="font-size: 12px; font-family: inherit; background: var(--card); color: var(--ink); border: 1px solid var(--accent); padding: 9px 14px; min-height: 44px">Configurar</button>
        <button type="button" style="font-size: 12px; font-family: inherit; background: var(--card); color: var(--ink); border: 1px solid var(--accent); padding: 9px 14px; min-height: 44px">Rechazar</button>
        <button type="button" style="font-size: 12px; font-family: inherit; background: var(--accent); color: var(--on-accent); border: 1px solid var(--accent); padding: 9px 14px; min-height: 44px">Aceptar todas</button>
      </div>
    </div>

    <footer style="flex: none; border-top: 1px solid var(--line); padding: 20px 48px; display: flex; gap: 56px; font-size: 12px; color: var(--muted); box-sizing: border-box">
      <div>
        <p style="margin: 0 0 6px; color: var(--ink); font-weight: 600">Contacto</p>
        <p style="margin: 0">contacto@tuna.example</p>
        <p style="margin: 0">+34 600 000 000</p>
      </div>
      <div>
        <p style="margin: 0 0 6px; color: var(--ink); font-weight: 600">Síguenos</p>
        <p style="margin: 0">Instagram · YouTube · Spotify</p>
      </div>
      <div>
        <p style="margin: 0 0 6px; color: var(--ink); font-weight: 600">Legal</p>
        <p style="margin: 0">Aviso legal · Política de privacidad · Política de cookies</p>
      </div>
      <div>
        <p style="margin: 0 0 6px; color: var(--ink); font-weight: 600">Únete</p>
        <p style="margin: 0"><a href="#/visitante/Formulario.html">Formulario para unirse (6.1)</a></p>
      </div>
    </footer>

</div></section>
<section class="screen" data-route="visitante/Conoce.html"><div class="wireframe">

    <header style="height: 72px; flex: none; border-bottom: 1px solid var(--line); display: flex; align-items: center; gap: 28px; padding: 0 48px; box-sizing: border-box">
      <a href="#/visitante/index.html" style="width: 92px; height: 38px; border: 1px solid var(--accent); display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-decoration: none">TUNA</a>
      <nav style="display: flex; gap: 20px; font-size: 13px">
        <a href="#/visitante/Conoce.html" style="text-decoration: none; font-weight: 700; border-bottom: 2px solid var(--gold); padding-bottom: 3px">Conoce la tuna</a>
        <a href="#/visitante/Contratacion.html" style="text-decoration: none">Contratación</a>
        <a href="#/visitante/Multimedia.html" style="text-decoration: none">Multimedia</a>
        <a href="#/visitante/Tienda.html" style="text-decoration: none">Tienda</a>
        <a href="#/visitante/Cancionero.html" style="text-decoration: none">Cancionero</a>
        <a href="#/visitante/Unete.html" style="text-decoration: none">Únete</a>
      </nav>
      <div style="margin-left: auto; display: flex; align-items: center; gap: 14px">
